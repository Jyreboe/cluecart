# Local development. Never commit a real .env file.
DATABASE_URL=postgresql://cluecart@127.0.0.1:5432/cluecart
API_PORT=3001
# Local password sign-in is accepted only outside production.
DEV_AUTH=1
# Production must use a trusted managed OIDC provider and HTTPS public URL.
# PUBLIC_APP_URL=https://cluecart.your-domain.example
# OIDC_ISSUER=https://your-identity-provider.example
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# NODE_ENV=production
# CHROMIUM_PATH=/usr/bin/chromium
# Private binary object storage is not implemented or configured.
# Optional Shopify adapter. Credentials must be raw runtime values, not proxy placeholders.
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# SHOPIFY_API_VERSION=2026-10
# Optional AI grouping; additionally requires owner consent in Settings.
AI_PROVIDER=rules
# AI_MODEL=
# CLUECART_AI_KEY=
