{
  "name": "cluecart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src server tests e2e",
    "test:e2e": "playwright test",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "DEV_AUTH=1 tsx watch server/index.ts",
    "db:migrate": "tsx server/db.ts",
    "test:api": "DEV_AUTH=1 DATABASE_URL=postgresql://cluecart@127.0.0.1:5432/cluecart_test tsx --test --test-concurrency=1 tests/api.test.ts tests/managed-auth.test.ts tests/shopify.test.ts tests/ai.test.ts",
    "start:api": "tsx server/index.ts",
    "db:local": "bash scripts/dev-db.sh",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "openai": "^7.42.0",
    "papaparse": "^5.5.3",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.2.0"
  }
}
